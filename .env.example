# LedgerStream Environment Configuration Template

# 1. Broker Infrastructure
KAFKA_BOOTSTRAP_SERVERS="localhost:9092"
KAFKA_TRANSACTIONS_TOPIC="transactions"
KAFKA_ALERTS_TOPIC="fraud-alerts"
KAFKA_DLQ_TOPIC="transactions-dlq"

# 2. Database connection DSN
PG_DSN="dbname=ledgerstream user=ledger password=ledger host=localhost port=5433"

# 3. API configuration
API_PORT=3001

# 4. Risk Policy Thresholds (ML fraud probability → business decision)
# LOW  risk:  score < RISK_LOW_THRESHOLD  → APPROVE
# HIGH risk:  score > RISK_HIGH_THRESHOLD → BLOCK
# MEDIUM:     in between                   → HOLD for review
RISK_LOW_THRESHOLD=0.01
RISK_HIGH_THRESHOLD=0.10

# 5. Demo generation (optional overrides)
DEMO_TRANSACTION_COUNT=20
DEMO_MIN_AMOUNT=10
DEMO_MAX_AMOUNT=50000
